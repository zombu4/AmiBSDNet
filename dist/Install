; AmiBSDNet installation script for the Amiga Installer (Workbench 3.2+)
;
; Installs the AmiBSDNet network stack, its tools and the Workbench status
; icon, writes the network configuration and starts the stack at boot
; from S:User-Startup.

(set #app "AmiBSDNet")
(set @app-name #app)
(set #ver "0.1")

(if (< (/ (getversion "exec.library" (resident)) 65536) 40)
	(abort "AmiBSDNet needs AmigaOS 3.1 or later (Workbench 3.2 recommended)."))

(if (or (= (database "cpu") "68000") (= (database "cpu") "68010"))
	(abort "AmiBSDNet needs a 68020 or better CPU (for example a PiStorm)."))

(message
	"\nAmiBSDNet " #ver "\n\n"
	"The NetBSD 11 TCP/IP network stack for AmigaOS.\n\n"
	"Installs the stack and the NetCtrl and Ping commands\n"
	"to C:, the status icon, and starts the network at\n"
	"every boot.\n\n"
	"Do not run another TCP/IP stack (Roadshow, Miami,\n"
	"AmiTCP) at the same time.")

(complete 0)

; -------------------------------------------------------------------
; programs

(copyfiles
	(prompt "Installing the AmiBSDNet programs to C:")
	(help @copyfiles-help)
	(source "C/")
	(dest "C:")
	(choices "AmiBSDNet" "NetCtrl" "Ping")
	(nogauge))

(complete 20)

(set #docdest
	(askdir
		(prompt "Where should the AmiBSDNet drawer (documentation and "
			"the status icon) be created?")
		(help @askdir-help)
		(default "SYS:")))
(set #drawer (tackon #docdest "AmiBSDNet"))
(makedir #drawer (infos))
(copyfiles
	(prompt "Installing the documentation")
	(help @copyfiles-help)
	(source "Docs/")
	(dest #drawer)
	(all)
	(infos)
	(nogauge))
(copyfiles
	(source "Status/")
	(dest #drawer)
	(all)
	(infos)
	(nogauge))

(complete 40)

; -------------------------------------------------------------------
; network configuration

; find the network adapters: NetCtrl PROBE opens every SANA-II driver
; and sets AmiBSDNet/Ethernet and AmiBSDNet/WiFi
(working "Looking for network adapters...")
(run "C:NetCtrl PROBE >NIL:" (safe))
(set #eth (getenv "AmiBSDNet/Ethernet"))
(set #wlan (getenv "AmiBSDNet/WiFi"))
(set #ethunit 0)
(set #wlanunit 0)

(set #manual 1)
(if (or (<> #eth "") (<> #wlan ""))
	(set #manual
		(not (askbool
			(prompt "Network adapters found:\n\n"
				(if (<> #eth "") (cat "Ethernet:  " #eth "\n") "")
				(if (<> #wlan "") (cat "Wi-Fi:  " #wlan "\n") "")
				"\nUse "
				(if (and (<> #eth "") (<> #wlan "")) "both adapters"
					"this adapter")
				" for the network?"
				(if (and (<> #eth "") (<> #wlan ""))
					"\n(They work at the same time; Ethernet is used\nfor the Internet while its cable is connected.)" ""))
			(help "AmiBSDNet found these SANA-II drivers in DEVS:Networks. "
				"Choose No to pick the driver yourself. The adapters can "
				"be changed later in the status icon's Settings window.")
			(choices "Yes" "Choose myself")
			(default 1)))))

(if #manual
	(
		(set #devfile
			(askfile
				(prompt "Choose the SANA-II driver of your network hardware "
					"(PiStorm Wi-Fi: wifipi.device, WinUAE: uaenet.device; "
					"type the name if it is not listed)")
				(help "AmiBSDNet talks to your network card through its SANA-II "
					"driver, normally found in DEVS:Networks/. Your card's "
					"documentation names the driver. If it is not listed "
					"(for example because it is built into ROM), type its "
					"name into the file field.")
				(default "DEVS:Networks/")))
		(set #device (fileonly #devfile))
		(set #unit
			(asknumber
				(prompt "Unit number of the network card (usually 0)")
				(help "Only needed when one driver handles several cards.")
				(range 0 31)
				(default 0)))
		(if (askbool
				(prompt "Is " #device " a Wi-Fi adapter (for example the "
					"PiStorm's wifipi.device)?")
				(help "For Wi-Fi, AmiBSDNet needs the network name and "
					"passphrase. You can change them later in the status "
					"icon's Settings window.")
				(default (if (patmatch "#?(wifi|wlan|prism|wireless)#?"
					#device) 1 0)))
			((set #eth "") (set #wlan #device) (set #wlanunit #unit))
			((set #eth #device) (set #ethunit #unit) (set #wlan "")))
	))

; Wi-Fi: the network name and passphrase go to Wireless.prefs, which
; WirelessManager (started by AmiBSDNet) uses to join the network
(if (<> #wlan "")
	(
		(if (not (exists "C:WirelessManager"))
			(message "Note: C:WirelessManager was not found.\n\n"
				"It is needed for WPA-protected Wi-Fi and comes with the "
				"Emu68 Wi-Fi package (wifipi.device). Install it, then "
				"AmiBSDNet starts it by itself."))
		(set #write-wifi 1)
		(if (exists "ENVARC:Sys/Wireless.prefs")
			(set #write-wifi
				(askbool
					(prompt "Wi-Fi settings already exist "
						"(ENVARC:Sys/Wireless.prefs). Replace them?")
					(help "Choose No to keep your current Wi-Fi network.")
					(default 0))))
		(if #write-wifi
			(
				(set #ssid
					(askstring
						(prompt "Name (SSID) of your Wi-Fi network\n"
							"(leave empty to choose it later from the "
							"status icon)")
						(help "Exactly as shown by your router, including "
							"upper and lower case.")
						(default "")))
				(if (<> #ssid "")
					(
						(set #psk
							(askstring
								(prompt "Wi-Fi passphrase (leave empty for "
									"an open network)")
								(help "8 to 63 characters for WPA/WPA2.")
								(default "")))
						(makedir "ENVARC:Sys")
						(if (= #psk "")
							(textfile
								(dest "ENVARC:Sys/Wireless.prefs")
								(append "network={\n\tssid=\"" #ssid "\"\n"
									"\tkey_mgmt=NONE\n}\n"))
							(textfile
								(dest "ENVARC:Sys/Wireless.prefs")
								(append "network={\n\tssid=\"" #ssid "\"\n"
									"\tpsk=\"" #psk "\"\n"
									"\tkey_mgmt=WPA-PSK\n}\n")))
						(makedir "ENV:Sys")
						(copyfiles (source "ENVARC:Sys/Wireless.prefs")
							(dest "ENV:Sys") (nogauge))
					))
			))
	))

(set #mode
	(askchoice
		(prompt "How does this Amiga get its network address?")
		(help "Most home networks hand out addresses automatically (DHCP). "
			"Choose a fixed address only if your network needs one; it is "
			"used for Ethernet if there is an Ethernet adapter, else for "
			"Wi-Fi.")
		(choices "Automatically (DHCP)" "Fixed address")
		(default 0)))

(set #hostname
	(askstring
		(prompt "Name of this computer on the network")
		(help "Letters, digits and '-' only.")
		(default "amiga")))

(set #addr "")
(set #gw "")
(set #dns "")
(if (= #mode 1)
	(
		(set #addr
			(askstring
				(prompt "Address and prefix length of this Amiga, "
					"for example 192.168.1.20/24")
				(help "The /24 means netmask 255.255.255.0.")
				(default "192.168.1.20/24")))
		(set #gw
			(askstring
				(prompt "Address of your router (default gateway)")
				(help @askstring-help)
				(default "192.168.1.1")))
		(set #dns
			(askstring
				(prompt "Address of your DNS server (often the router)")
				(help @askstring-help)
				(default #gw)))
	))

; one interface per adapter, Ethernet first (the preferred route); a
; fixed address goes to the first one
(set #fixedtext (cat " address " #addr))
(set #ethline "")
(set #wlanline "")
(set #next "sana0")
(if (<> #eth "")
	(
		(set #ethline (cat "interface  sana0 " #eth " " #ethunit
			(if (= #mode 1) #fixedtext " dhcp") "\n"))
		(set #next "sana1")
	))
(if (<> #wlan "")
	(set #wlanline (cat "interface  " #next " " #wlan " " #wlanunit
		(if (and (= #mode 1) (= #eth "")) #fixedtext " dhcp")
		" wifi\n")))

(set #confdir "ENVARC:AmiBSDNet")
(makedir #confdir)
(set #conf (tackon #confdir "AmiBSDNet.conf"))
(textfile
	(prompt "Writing the network configuration")
	(help @textfile-help)
	(dest #conf)
	(append "# AmiBSDNet configuration (see the AmiBSDNet documentation; "
		"the status icon's Settings window edits it)\n")
	(append "hostname   " #hostname "\n")
	(append #ethline)
	(append #wlanline)
	(append (if (<> #gw "") (cat "gateway    " #gw "\n") ""))
	(append (if (<> #dns "") (cat "nameserver " #dns "\n") "")))

; the running system reads ENV:
(makedir "ENV:AmiBSDNet")
(copyfiles (source #conf) (dest "ENV:AmiBSDNet") (nogauge))

; a hosts file for local names, unless one exists
(if (not (exists "DEVS:Internet/hosts"))
	(
		(makedir "DEVS:Internet")
		(textfile
			(dest "DEVS:Internet/hosts")
			(append "# host name table: address  name  [aliases]\n")
			(append "127.0.0.1  localhost\n"))
	))

(complete 70)

; -------------------------------------------------------------------
; start at boot

(startup #app
	(prompt "AmiBSDNet will be started from S:User-Startup at every boot.")
	(help @startup-help)
	(command "C:AmiBSDNet\n"))

(if (askbool
		(prompt "Show the AmiBSDNet status icon on the Workbench at every "
			"boot (copies AmiBSDNetStatus to WBStartup)?")
		(help "The icon shows whether you are online and your address. "
			"Double-click it for details, to go online or offline.")
		(default 1))
	(copyfiles
		(source (tackon #drawer "AmiBSDNetStatus"))
		(dest "SYS:WBStartup")
		(infos)
		(nogauge)))

(complete 100)

(exit
	"AmiBSDNet is installed.\n\n"
	"Reboot to start the network, or type C:AmiBSDNet in a Shell now.\n"
	"\"NetCtrl\" shows the network status.")
